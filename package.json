{
  "name": "recipe-finder",
  "version": "1.0.7",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --disable-warning=ExperimentalWarning --watch server/index.ts\" \"vite --config client/vite.config.ts\"",
    "build": "vite build --config client/vite.config.ts",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "import": "node --disable-warning=ExperimentalWarning server/scripts/import.ts",
    "audit": "node --disable-warning=ExperimentalWarning server/scripts/audit.ts",
    "export-aliases": "node --disable-warning=ExperimentalWarning server/scripts/export-aliases.ts",
    "release": "node --disable-warning=ExperimentalWarning server/scripts/release.ts",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/**/*.test.ts\" \"client/src/**/*.test.ts\"",
    "typecheck": "tsc && tsc -p client"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^5.8.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
